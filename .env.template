# Amazon Nova API Keys and Configuration
# This is a template file. Rename to .env and fill with your values
# DO NOT commit your actual .env file with real credentials to version control

# AWS Credentials
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Amazon Nova Model IDs
NOVA_MODEL_ID=amazon.nova-lite-v1:0
NOVA_PRO_MODEL_ID=amazon.nova-pro-v1:0
NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0
NOVA_CANVAS_MODEL_ID=amazon.nova-canvas-v1:0
NOVA_REEL_MODEL_ID=amazon.nova-reel-v1:0

# Model Configuration
MAX_TOKENS=1000
TEMPERATURE=0.7
TOP_P=0.9

# Image Generation Configuration
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
NUMBER_OF_IMAGES=1
CFG_SCALE=8.0

# Video Generation Configuration
VIDEO_WIDTH=1024
VIDEO_HEIGHT=576
VIDEO_DURATION_SECONDS=4 